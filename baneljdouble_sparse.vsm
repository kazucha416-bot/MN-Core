dvmulu $ln4 $lm2 $lr18 # 0.5 * h
nop
dvadd $ls10 $lr16 $nowrite # f1 + f2
dvmulu $mauf $lm10 $nowrite # (f1 + f2) / mass
dvfmau $mauf $lr18 $ln0 $ln0 # velocity update
