dvmulu $ln4 $lm4 $lr22
nop
dvmulu $ln0 $ln0 $nowrite 
dvmulu $mauf $lr22 $lm16 # kinetic energy
nop/2
# total energy
dvpassa $lm16 $nowrite
dvadd $mauf $lm14 $nowrite
dvpassa $mauf $lm18 # set total energy
nop/2
