fvmul $mauf $ln16v $nowrite
fvmul $mauf $ln8v $ls24v # fcがls24vに入る このあとlr0v~lr16vの座標と掛け算をするのでlsに格納
nop
# fx,fy,fzを求める fx = fc * x
