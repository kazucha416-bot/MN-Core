fvmul $lr48v $mauf $nowrite # r2*y0^2
fvfma $mauf -$ls0v $ln8v $nowrite # 1.5 - 0.5*r2*y0^2
fvmul $lr56v $mauf $lr56v # y1 = y0 * (1.5 - 0.5*r2*y0^2)
nop
