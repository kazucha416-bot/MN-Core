nop
fvpassa $lr8v $nowrite
fvadd $lr0v $mauf $nowrite
fvadd $lr16v $mauf $lr0v
imm f"0.5" $nowrite # m/2
fvmul $lr0v $aluf $lr0v # 運動エネルギー完成　lr0vに入る
