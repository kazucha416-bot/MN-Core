fvmul $lr48v $mauf $nowrite # r2*y1^2
fvfma $mauf -$ls0v $ln8v $nowrite # 1.5 - 0.5*r2*y1^2
fvmul $lr56v $mauf $lr56v # y2 = y1 * (1.5 - 0.5*r2*y1^2)
nop
# NR法3回目
