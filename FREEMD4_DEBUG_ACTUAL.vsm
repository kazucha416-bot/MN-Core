fvmul $mauf $lr8v $lr0v
fvadd $ls56v $lr80v $nowrite
fvfma $mauf $lr0v $ln0v $ln0v # velocity更新完了
nop/2
# 運動エネルギーを求める
fvmul $ln0v $ln0v $lr[0,8,16,24]
nop
fvpassa $lr8v $nowrite
