fvmul $lr56v $lr56v $ln8v
nop/2
# r6iを求める = r2i^3
fvmul $ln8v $ln8v $nowrite
fvmul $mauf $ln8v $nowrite
fvpassa $mauf $ln16v
nop/2
# ep = ce12 * r12i - ce06 * r06iを求める
fvfma $lr64v $ln16v -$ls8v $nowrite
fvmul $mauf $ln16v $lm8v
nop/2
l1bmm@0 $lm8v $lb7552 # メモリは16ずつ増やす
