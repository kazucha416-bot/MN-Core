fvmul $lr8v $lr8v $lr[26,34,42,50]
fvmul $lr16v $lr16v $lr[28,36,44,52]
nop
# 足し合わせてr^2が求まる
fvpassa $lr24v $nowrite
fvadd $mauf $lr32v $nowrite
fvadd $mauf $lr40v $lr48v
nop
