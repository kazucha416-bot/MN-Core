fvfma $ls0v $mauf $lm0v $ls0v #中間結果
imm f"0.001" $nowrite # h
fvfma $aluf $ln0v $ls0v $lm0v # pos = pos + h*v + (0.5*h^2/mass)*force1 更新完了
