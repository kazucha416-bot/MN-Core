fvadd $ls32v $mauf $nowrite
fvadd $mauf $ls48v $lr80v # lr80vにforce2が入った 後ほどf1+f2をするためlrに格納
nop/2
# Update Velocity v[0][j] = v[0][j] + 0.5 * dt / mas[j] * (force1[0][j] + force2[0][j])
imm f"0.5" $lr0v #　係数
imm f"0.001" $ls0v # h
imm f"1.0" $lr8v # 1/mass
