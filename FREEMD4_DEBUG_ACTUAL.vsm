imm f"0.5" $lr0v #　係数
imm f"0.001" $ls0v # h
imm f"1.0" $lr8v # 1/mass
fvmul $lr0v $ls0v $nowrite
fvmul $mauf $lr8v $lr0v
fvadd $ls56v $lr80v $nowrite
fvfma $mauf $lr0v $ln0v $ln0v # velocity更新完了
nop/2
