imm f"0.5" $nowrite # m/2
fvmul $lr0v $aluf $lr0v # 運動エネルギー完成　lr0vに入る
# L1BMに入っているポテンシャルエネルギーをL2BMに転送
l2bm@0 $lb4096 $lc4096
# 空になったL1BMに運動エネルギーを転送
l1bmm@0 $lr0v $lb1024
fvpassa $lr80v $ls56v # force2を次のforce1へ．

