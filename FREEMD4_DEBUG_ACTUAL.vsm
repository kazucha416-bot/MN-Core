fvmul $lr56v $mauf $lr56v # y3 = y2 * (1.5 - 0.5*r2*y2^2)
nop
# NR法4回目
fvmul $lr56v $lr56v $nowrite # y3^2
fvmul $lr48v $mauf $nowrite # r2*y3^2
