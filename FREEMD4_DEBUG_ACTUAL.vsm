# 2回転目
msr $ls0v $ls0v
nop
fvadd $lm0v -$ls0v $lr8v
# 3回転目
msr $ls0v $ls0v
nop
fvadd $lm0v -$ls0v $lr16v
# r^2を計算するために各要素の二乗を求める
